# Local development example only. Copy to .env (gitignored) and adjust.
# The API binds to loopback by default; use a tunnel or proxy to reach it.
PORT=8080
DATABASE_URL=postgres://vendorproof:CHANGE_ME@localhost:5432/vendorproof?sslmode=disable
OIDC_ISSUER=http://127.0.0.1:9000
OIDC_AUDIENCE=vendorproof-api
OIDC_JWKS_URL=http://127.0.0.1:9000/.well-known/jwks.json
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OIDC_REQUIRED_TOKEN_TYPE=at+jwt
# OIDC_STALE_KEY_GRACE=15m
LOG_LEVEL=info
